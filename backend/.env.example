NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=garage_db
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

JWT_PRIVATE_KEY=<base64 of an ES256 (P-256) PKCS#8 PEM — see README>
JWT_PUBLIC_KEY=<base64 of the matching public PEM>
JWT_KEY_ID=dev-2026-10
JWT_ISSUER=garage-api
JWT_AUDIENCE=garage-clients
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=false
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
THROTTLE_PORTAL_LIMIT=30

CUSTOMER_PORTAL_URL=http://localhost:3001/portal
CUSTOMER_LINK_TTL_DAYS=7

MAIL_DRIVER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Garage <no-reply@garage.local>"
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_MS=5000
